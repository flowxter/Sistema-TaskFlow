# URL base del backend. Sin barra final.
#
# En desarrollo se deja vacia o sin definir: las peticiones salen relativas y el
# proxy de vite.config.js las reenvia a http://localhost:8080.
#
# En Vercel se define con la URL publica de Railway, por ejemplo:
#   VITE_API_URL=https://taskflow-api-production.up.railway.app
VITE_API_URL=
